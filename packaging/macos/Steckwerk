#!/bin/sh
# Steckwerk.app – Startskript (Contents/MacOS/Steckwerk)
#
# Sucht ein Python ab 3.8 (Homebrew, python.org, Command Line Tools von Apple), startet damit
# Contents/Resources/steckwerk/steckwerk_app.py im Hintergrund und beendet sich sofort.
# So öffnet jeder weitere Doppelklick einfach wieder das Steckwerk-Fenster.
# Protokoll: ~/Library/Logs/Steckwerk.log

APP_DIR="$(cd "$(dirname "$0")/../.." && pwd -P)"
CODE="$APP_DIR/Contents/Resources/steckwerk"
LOG_DIR="$HOME/Library/Logs"
LOG="$LOG_DIR/Steckwerk.log"
mkdir -p "$LOG_DIR"
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 1000000 ]; then mv -f "$LOG" "$LOG.1"; fi

python_ok() {
  "$1" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1
}

PY=""
if [ -n "$STECKWERK_PYTHON" ] && python_ok "$STECKWERK_PYTHON"; then
  PY="$STECKWERK_PYTHON"                    # eigenes Python vorgeben (z. B. für Tests)
else
  for cand in /opt/homebrew/bin/python3 \
              /usr/local/bin/python3 \
              /Library/Frameworks/Python.framework/Versions/Current/bin/python3 \
              "$HOME/.pyenv/shims/python3" \
              /opt/local/bin/python3 \
              /usr/bin/python3; do
    [ -x "$cand" ] || continue
    # /usr/bin/python3 ist nur ein Platzhalter, solange Apples Command Line Tools fehlen
    if [ "$cand" = /usr/bin/python3 ] && ! xcode-select -p >/dev/null 2>&1; then continue; fi
    if python_ok "$cand"; then PY="$cand"; break; fi
  done
fi

if [ -z "$PY" ]; then
  echo "$(date '+%Y-%m-%d %H:%M:%S') kein Python 3.8+ gefunden" >> "$LOG"
  case "$(defaults read -g AppleLanguages 2>/dev/null | tr -d ' "(\n' | cut -c1-2)" in
    de) MSG='Steckwerk braucht Python 3.

macOS bringt es mit den „Command Line Tools“ von Apple mit. Klicke auf „Installieren“, bestätige das folgende Fenster und öffne Steckwerk danach noch einmal.

Alternativ: Python von python.org installieren.'; NO="Abbrechen"; YES="Installieren" ;;
    *) MSG='Steckwerk needs Python 3.

macOS includes it with Apple’s “Command Line Tools”. Click “Install”, confirm the following window and then open Steckwerk again.

Alternatively: install Python from python.org.'; NO="Cancel"; YES="Install" ;;
  esac
  ANSWER=$(osascript -e 'on run argv' -e 'activate' \
    -e 'display dialog (item 1 of argv) with title "Steckwerk" buttons {item 2 of argv, item 3 of argv} default button (item 3 of argv) with icon caution' \
    -e 'end run' "$MSG" "$NO" "$YES" 2>/dev/null)
  case "$ANSWER" in
    *"$YES"*) xcode-select --install >> "$LOG" 2>&1 ;;
  esac
  exit 1
fi

export PYTHONDONTWRITEBYTECODE=1
if [ -n "$STECKWERK_SELFTEST" ]; then
  exec "$PY" "$CODE/steckwerk_app.py" --self-test
fi
echo "$(date '+%Y-%m-%d %H:%M:%S') Start: $PY" >> "$LOG"
case "$APP_DIR" in
  */AppTranslocation/*)
    # macOS startet eine App aus „Downloads“ von einer temporären Kopie, die verschwindet, sobald
    # dieses Skript endet. Dann im Vordergrund laufen, bis Steckwerk beendet bzw. installiert ist.
    exec "$PY" "$CODE/steckwerk_app.py" --bundle "$APP_DIR" "$@" >> "$LOG" 2>&1 < /dev/null ;;
esac
nohup "$PY" "$CODE/steckwerk_app.py" --bundle "$APP_DIR" "$@" >> "$LOG" 2>&1 < /dev/null &
exit 0
